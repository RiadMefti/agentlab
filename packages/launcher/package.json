{
  "name": "agentlab",
  "version": "0.2.5",
  "description": "Run Codex, Claude Code, and OpenCode in one local terminal, with one captain per project.",
  "keywords": [
    "ai",
    "coding-agents",
    "codex",
    "claude-code",
    "opencode",
    "multi-agent",
    "terminal",
    "tui",
    "tmux"
  ],
  "type": "module",
  "bin": {
    "agentlab": "dist/agentlab.js"
  },
  "files": [
    "dist/*.js",
    "release-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "npm run build && node dist/prepack.js",
    "typecheck": "tsc --build --pretty false"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiadMefti/agentlab.git",
    "directory": "packages/launcher"
  },
  "bugs": {
    "url": "https://github.com/RiadMefti/agentlab/issues"
  },
  "homepage": "https://github.com/RiadMefti/agentlab",
  "publishConfig": {
    "access": "public"
  }
}
